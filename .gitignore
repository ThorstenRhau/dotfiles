# Starship generated configs (built from src/)
starship/.config/starship.toml
starship/.config/starship-*.toml

# Local Token appearance adapters
ghostty/.config/ghostty/token-active.ghostty
herdr/.config/herdr/config.toml
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/sessions/
tmux/.config/tmux/token-active.conf

# Zsh specific local files that are ignored
zsh/.config/zsh/local.zsh
zsh/.config/zsh/secrets.zsh
zsh/.config/zsh/.zsh_history
zsh/.config/zsh/.zcompdump
zsh/.config/zsh/.zcompcache/
zsh/.config/zsh/.zsh_sessions
**/__pycache__/
*.py[cod]
*$py.class

# macOS specific
**/.DS_Store
