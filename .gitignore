# Starship generated configs (built from src/)
starship/.config/starship.toml
starship/.config/starship_dark.toml
starship/.config/starship_light.toml

# Zsh specific local files that are ignored
zsh/.config/zsh/local.zsh
zsh/.config/zsh/secrets.zsh
zsh/.config/zsh/.zsh_history
zsh/.config/zsh/.zcompdump
zsh/.config/zsh/.zcompcache/
zsh/.config/zsh/.zsh_sessions
**/__pycache__/
*.py[cod]
*$py.class

# Google Gemini-cli specific local files that are ignored
gemini/.gemini/google_accounts.json
gemini/.gemini/history/
gemini/.gemini/oauth_creds.json
gemini/.gemini/tmp/

# macOS specific
**/.DS_Store

# Tasks directory
tasks/
