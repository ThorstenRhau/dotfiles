# Generated from the token light palette. Do not edit manually.

[color "advice"]
	hint = "#185b5b"

[color "blame"]
	repeatedLines = "#524e46"

[color "branch"]
	current = "bold #863716"
	local = "bold #315270"
	plain = "#323128"
	remote = "bold #185b5b"
	upstream = "bold #185b5b"
	worktree = "bold #573c72"

[color "decorate"]
	HEAD = "bold #863716"
	branch = "bold #365a33"
	grafted = "#504b44"
	remoteBranch = "bold #185b5b"
	stash = "#573c72"
	tag = "bold #613500"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#315270"

[color "grep"]
	column = "#185b5b"
	context = "#504b44"
	filename = "bold #315270"
	function = "#573c72"
	lineNumber = "#857238"
	match = "bold #863716"
	matchContext = "bold #863716"
	matchSelected = "bold #863716"
	selected = "#323128"
	separator = "#524e46"

[color "interactive"]
	error = "bold #ad5253"
	header = "bold #573c72"
	help = "#504b44"
	plain = "#323128"
	prompt = "bold #863716"

[color "push"]
	error = "bold #ad5253"

[color "remote"]
	error = "bold #ad5253"
	hint = "#185b5b"
	success = "#365a33"
	warning = "#857238"

[color "status"]
	added = "#365a33"
	branch = "bold #863716"
	changed = "bold #857238"
	header = "#504b44"
	localBranch = "#315270"
	noBranch = "bold #ad5253"
	remoteBranch = "#185b5b"
	unmerged = "bold #ad5253"
	untracked = "#185b5b"
	updated = "#365a33"

[color "transport"]
	rejected = "bold #ad5253"
