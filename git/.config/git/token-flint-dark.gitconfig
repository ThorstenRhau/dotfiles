# Generated from the token-flint dark palette. Do not edit manually.

[color "advice"]
	hint = "#98BBD4"

[color "blame"]
	repeatedLines = "#858F9B"

[color "branch"]
	current = "bold #EB9E83"
	local = "bold #88ACC4"
	plain = "#C3C8CC"
	remote = "bold #98BBD4"
	upstream = "bold #98BBD4"
	worktree = "bold #E09478"

[color "decorate"]
	HEAD = "bold #EB9E83"
	branch = "bold #A9B98C"
	grafted = "#9AA4AE"
	remoteBranch = "bold #98BBD4"
	stash = "#E09478"
	tag = "bold #9DAD7F"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#88ACC4"

[color "grep"]
	column = "#98BBD4"
	context = "#9AA4AE"
	filename = "bold #88ACC4"
	function = "#E09478"
	lineNumber = "#C5A15A"
	match = "bold #EB9E83"
	matchContext = "bold #EB9E83"
	matchSelected = "bold #EB9E83"
	selected = "#C3C8CC"
	separator = "#858F9B"

[color "interactive"]
	error = "bold #E3888C"
	header = "bold #E09478"
	help = "#9AA4AE"
	plain = "#C3C8CC"
	prompt = "bold #EB9E83"

[color "push"]
	error = "bold #E3888C"

[color "remote"]
	error = "bold #E3888C"
	hint = "#98BBD4"
	success = "#A9B98C"
	warning = "#C5A15A"

[color "status"]
	added = "#A9B98C"
	branch = "bold #EB9E83"
	changed = "bold #C5A15A"
	header = "#9AA4AE"
	localBranch = "#88ACC4"
	noBranch = "bold #E3888C"
	remoteBranch = "#98BBD4"
	unmerged = "bold #E3888C"
	untracked = "#98BBD4"
	updated = "#A9B98C"

[color "transport"]
	rejected = "bold #E3888C"
