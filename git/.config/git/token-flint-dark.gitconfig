# Generated from the token-flint dark palette. Do not edit manually.

[color "advice"]
	hint = "#81c2c2"

[color "blame"]
	repeatedLines = "#858f9b"

[color "branch"]
	current = "bold #eb9e83"
	local = "bold #88acc4"
	plain = "#c3c8cc"
	remote = "bold #81c2c2"
	upstream = "bold #81c2c2"
	worktree = "bold #e09478"

[color "decorate"]
	HEAD = "bold #eb9e83"
	branch = "bold #a9b98c"
	grafted = "#9aa4ae"
	remoteBranch = "bold #81c2c2"
	stash = "#e09478"
	tag = "bold #f8d28a"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#88acc4"

[color "grep"]
	column = "#81c2c2"
	context = "#9aa4ae"
	filename = "bold #88acc4"
	function = "#e09478"
	lineNumber = "#c5a15a"
	match = "bold #eb9e83"
	matchContext = "bold #eb9e83"
	matchSelected = "bold #eb9e83"
	selected = "#c3c8cc"
	separator = "#858f9b"

[color "interactive"]
	error = "bold #e3888c"
	header = "bold #e09478"
	help = "#9aa4ae"
	plain = "#c3c8cc"
	prompt = "bold #eb9e83"

[color "push"]
	error = "bold #e3888c"

[color "remote"]
	error = "bold #e3888c"
	hint = "#81c2c2"
	success = "#a9b98c"
	warning = "#c5a15a"

[color "status"]
	added = "#a9b98c"
	branch = "bold #eb9e83"
	changed = "bold #c5a15a"
	header = "#9aa4ae"
	localBranch = "#88acc4"
	noBranch = "bold #e3888c"
	remoteBranch = "#81c2c2"
	unmerged = "bold #e3888c"
	untracked = "#81c2c2"
	updated = "#a9b98c"

[color "transport"]
	rejected = "bold #e3888c"
