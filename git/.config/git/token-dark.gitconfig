# Generated from the token dark palette. Do not edit manually.

[color "advice"]
	hint = "#7dbbba"

[color "blame"]
	repeatedLines = "#8a8884"

[color "branch"]
	current = "bold #f4906f"
	local = "bold #81a5c4"
	plain = "#c3c0b8"
	remote = "bold #7dbbba"
	upstream = "bold #7dbbba"
	worktree = "bold #b195ca"

[color "decorate"]
	HEAD = "bold #f4906f"
	branch = "bold #8fb78c"
	grafted = "#a19c94"
	remoteBranch = "bold #7dbbba"
	stash = "#b195ca"
	tag = "bold #d6924c"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#81a5c4"

[color "grep"]
	column = "#7dbbba"
	context = "#a19c94"
	filename = "bold #81a5c4"
	function = "#b195ca"
	lineNumber = "#b99d4a"
	match = "bold #f4906f"
	matchContext = "bold #f4906f"
	matchSelected = "bold #f4906f"
	selected = "#c3c0b8"
	separator = "#8a8884"

[color "interactive"]
	error = "bold #d68585"
	header = "bold #b195ca"
	help = "#a19c94"
	plain = "#c3c0b8"
	prompt = "bold #f4906f"

[color "push"]
	error = "bold #d68585"

[color "remote"]
	error = "bold #d68585"
	hint = "#7dbbba"
	success = "#8fb78c"
	warning = "#b99d4a"

[color "status"]
	added = "#8fb78c"
	branch = "bold #f4906f"
	changed = "bold #b99d4a"
	header = "#a19c94"
	localBranch = "#81a5c4"
	noBranch = "bold #d68585"
	remoteBranch = "#7dbbba"
	unmerged = "bold #d68585"
	untracked = "#7dbbba"
	updated = "#8fb78c"

[color "transport"]
	rejected = "bold #d68585"
