# Generated from the Token dark palette. Do not edit manually.

[color "advice"]
	hint = "#6ba8a8"

[color "blame"]
	repeatedLines = "#5a5955"

[color "branch"]
	current = "bold #d97757"
	local = "bold #7b9ebd"
	plain = "#e8e4dc"
	remote = "bold #6ba8a8"
	upstream = "bold #6ba8a8"
	worktree = "bold #a68bbf"

[color "decorate"]
	HEAD = "bold #d97757"
	branch = "bold #7da47a"
	grafted = "#938e87"
	remoteBranch = "bold #6ba8a8"
	stash = "#a68bbf"
	tag = "bold #d4914a"

[color "diff"]
	commit = "#7b9ebd"
	context = "#e8e4dc"
	contextBold = "bold #e8e4dc"
	contextDimmed = "#938e87"
	frag = "bold #a68bbf"
	func = "#6ba8a8"
	meta = "#7b9ebd"
	new = "#7da47a"
	newBold = "bold #7da47a"
	newDimmed = "#938e87"
	newMoved = "#6ba8a8"
	newMovedAlternative = "#7b9ebd"
	newMovedAlternativeDimmed = "#938e87"
	newMovedDimmed = "#938e87"
	old = "#c67777"
	oldBold = "bold #c67777"
	oldDimmed = "#938e87"
	oldMoved = "#c4a855"
	oldMovedAlternative = "#c4956a"
	oldMovedAlternativeDimmed = "#938e87"
	oldMovedDimmed = "#938e87"
	whitespace = "bold reverse #c67777"

[color "grep"]
	column = "#6ba8a8"
	context = "#938e87"
	filename = "bold #7b9ebd"
	function = "#a68bbf"
	lineNumber = "#c4a855"
	match = "bold #d97757"
	matchContext = "bold #d97757"
	matchSelected = "bold #d97757"
	selected = "#e8e4dc"
	separator = "#5a5955"

[color "interactive"]
	error = "bold #c67777"
	header = "bold #a68bbf"
	help = "#938e87"
	plain = "#e8e4dc"
	prompt = "bold #d97757"

[color "push"]
	error = "bold #c67777"

[color "remote"]
	error = "bold #c67777"
	hint = "#6ba8a8"
	success = "#7da47a"
	warning = "#c4a855"

[color "status"]
	added = "#7da47a"
	branch = "bold #d97757"
	changed = "#c4a855"
	header = "#938e87"
	localBranch = "#7b9ebd"
	noBranch = "bold #c67777"
	remoteBranch = "#6ba8a8"
	unmerged = "bold #c67777"
	untracked = "#6ba8a8"
	updated = "#7da47a"

[color "transport"]
	rejected = "bold #c67777"
