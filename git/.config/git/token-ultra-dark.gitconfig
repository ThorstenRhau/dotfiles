# Generated from the token-ultra dark palette. Do not edit manually.

[color "advice"]
	hint = "#7ebcbb"

[color "blame"]
	repeatedLines = "#8d8983"

[color "branch"]
	current = "bold #ed9574"
	local = "bold #8aa5bb"
	plain = "#c5c1b8"
	remote = "bold #7ebcbb"
	upstream = "bold #7ebcbb"
	worktree = "bold #b296cb"

[color "decorate"]
	HEAD = "bold #ed9574"
	branch = "bold #9ab58e"
	grafted = "#a39d94"
	remoteBranch = "bold #7ebcbb"
	stash = "#b296cb"
	tag = "bold #78aba4"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#8aa5bb"

[color "grep"]
	column = "#7ebcbb"
	context = "#a39d94"
	filename = "bold #8aa5bb"
	function = "#b296cb"
	lineNumber = "#bf9c53"
	match = "bold #ed9574"
	matchContext = "bold #ed9574"
	matchSelected = "bold #ed9574"
	selected = "#c5c1b8"
	separator = "#8d8983"

[color "interactive"]
	error = "bold #dd8384"
	header = "bold #b296cb"
	help = "#a39d94"
	plain = "#c5c1b8"
	prompt = "bold #ed9574"

[color "push"]
	error = "bold #dd8384"

[color "remote"]
	error = "bold #dd8384"
	hint = "#7ebcbb"
	success = "#9ab58e"
	warning = "#bf9c53"

[color "status"]
	added = "#9ab58e"
	branch = "bold #ed9574"
	changed = "bold #bf9c53"
	header = "#a39d94"
	localBranch = "#8aa5bb"
	noBranch = "bold #dd8384"
	remoteBranch = "#7ebcbb"
	unmerged = "bold #dd8384"
	untracked = "#7ebcbb"
	updated = "#9ab58e"

[color "transport"]
	rejected = "bold #dd8384"
