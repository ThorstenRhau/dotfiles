# Generated from the token-meridian light palette. Do not edit manually.

[color "advice"]
	hint = "#095b62"

[color "blame"]
	repeatedLines = "#616f7c"

[color "branch"]
	current = "bold #0048b3"
	local = "bold #0048b3"
	plain = "#28323a"
	remote = "bold #095b62"
	upstream = "bold #095b62"
	worktree = "bold #832882"

[color "decorate"]
	HEAD = "bold #0048b3"
	branch = "bold #005f2f"
	grafted = "#6c645b"
	remoteBranch = "bold #095b62"
	stash = "#832882"
	tag = "bold #843900"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#0048b3"

[color "grep"]
	column = "#095b62"
	context = "#6c645b"
	filename = "bold #0048b3"
	function = "#832882"
	lineNumber = "#89661b"
	match = "bold #0048b3"
	matchContext = "bold #0048b3"
	matchSelected = "bold #0048b3"
	selected = "#28323a"
	separator = "#616f7c"

[color "interactive"]
	error = "bold #ae5158"
	header = "bold #832882"
	help = "#6c645b"
	plain = "#28323a"
	prompt = "bold #0048b3"

[color "push"]
	error = "bold #ae5158"

[color "remote"]
	error = "bold #ae5158"
	hint = "#095b62"
	success = "#005f2f"
	warning = "#89661b"

[color "status"]
	added = "#005f2f"
	branch = "bold #0048b3"
	changed = "bold #89661b"
	header = "#6c645b"
	localBranch = "#0048b3"
	noBranch = "bold #ae5158"
	remoteBranch = "#095b62"
	unmerged = "bold #ae5158"
	untracked = "#095b62"
	updated = "#005f2f"

[color "transport"]
	rejected = "bold #ae5158"
