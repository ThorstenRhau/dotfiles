# Generated from the token-temper dark palette. Do not edit manually.

[color "advice"]
	hint = "#62C7B9"

[color "blame"]
	repeatedLines = "#858F9B"

[color "branch"]
	current = "bold #5CC1B3"
	local = "bold #51B8AA"
	plain = "#C3C8CC"
	remote = "bold #62C7B9"
	upstream = "bold #62C7B9"
	worktree = "bold #C294E6"

[color "decorate"]
	HEAD = "bold #5CC1B3"
	branch = "bold #5EC4B5"
	grafted = "#9AA4AE"
	remoteBranch = "bold #62C7B9"
	stash = "#C294E6"
	tag = "bold #51B7AA"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#51B8AA"

[color "grep"]
	column = "#62C7B9"
	context = "#9AA4AE"
	filename = "bold #51B8AA"
	function = "#C294E6"
	lineNumber = "#C5A15A"
	match = "bold #5CC1B3"
	matchContext = "bold #5CC1B3"
	matchSelected = "bold #5CC1B3"
	selected = "#C3C8CC"
	separator = "#858F9B"

[color "interactive"]
	error = "bold #E3888C"
	header = "bold #C294E6"
	help = "#9AA4AE"
	plain = "#C3C8CC"
	prompt = "bold #5CC1B3"

[color "push"]
	error = "bold #E3888C"

[color "remote"]
	error = "bold #E3888C"
	hint = "#62C7B9"
	success = "#5EC4B5"
	warning = "#C5A15A"

[color "status"]
	added = "#5EC4B5"
	branch = "bold #5CC1B3"
	changed = "bold #C5A15A"
	header = "#9AA4AE"
	localBranch = "#51B8AA"
	noBranch = "bold #E3888C"
	remoteBranch = "#62C7B9"
	unmerged = "bold #E3888C"
	untracked = "#62C7B9"
	updated = "#5EC4B5"

[color "transport"]
	rejected = "bold #E3888C"
