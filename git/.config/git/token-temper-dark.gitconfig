# Generated from the token-temper dark palette. Do not edit manually.

[color "advice"]
	hint = "#62c7b9"

[color "blame"]
	repeatedLines = "#858f9b"

[color "branch"]
	current = "bold #5cc1b3"
	local = "bold #53b4ce"
	plain = "#c3c8cc"
	remote = "bold #62c7b9"
	upstream = "bold #62c7b9"
	worktree = "bold #c294e6"

[color "decorate"]
	HEAD = "bold #5cc1b3"
	branch = "bold #7fc291"
	grafted = "#9aa4ae"
	remoteBranch = "bold #62c7b9"
	stash = "#c294e6"
	tag = "bold #e7cdff"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#53b4ce"

[color "grep"]
	column = "#62c7b9"
	context = "#9aa4ae"
	filename = "bold #53b4ce"
	function = "#c294e6"
	lineNumber = "#c5a15a"
	match = "bold #5cc1b3"
	matchContext = "bold #5cc1b3"
	matchSelected = "bold #5cc1b3"
	selected = "#c3c8cc"
	separator = "#858f9b"

[color "interactive"]
	error = "bold #e3888c"
	header = "bold #c294e6"
	help = "#9aa4ae"
	plain = "#c3c8cc"
	prompt = "bold #5cc1b3"

[color "push"]
	error = "bold #e3888c"

[color "remote"]
	error = "bold #e3888c"
	hint = "#62c7b9"
	success = "#7fc291"
	warning = "#c5a15a"

[color "status"]
	added = "#7fc291"
	branch = "bold #5cc1b3"
	changed = "bold #c5a15a"
	header = "#9aa4ae"
	localBranch = "#53b4ce"
	noBranch = "bold #e3888c"
	remoteBranch = "#62c7b9"
	unmerged = "bold #e3888c"
	untracked = "#62c7b9"
	updated = "#7fc291"

[color "transport"]
	rejected = "bold #e3888c"
