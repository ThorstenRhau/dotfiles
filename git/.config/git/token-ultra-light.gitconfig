# Generated from the token-ultra light palette. Do not edit manually.

[color "advice"]
	hint = "#185b5b"

[color "blame"]
	repeatedLines = "#544e44"

[color "branch"]
	current = "bold #893517"
	local = "bold #37526a"
	plain = "#31312b"
	remote = "bold #185b5b"
	upstream = "bold #185b5b"
	worktree = "bold #573c72"

[color "decorate"]
	HEAD = "bold #893517"
	branch = "bold #385a35"
	grafted = "#514b44"
	remoteBranch = "bold #185b5b"
	stash = "#573c72"
	tag = "bold #004943"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#37526a"

[color "grep"]
	column = "#185b5b"
	context = "#514b44"
	filename = "bold #37526a"
	function = "#573c72"
	lineNumber = "#926e25"
	match = "bold #893517"
	matchContext = "bold #893517"
	matchSelected = "bold #893517"
	selected = "#31312b"
	separator = "#544e44"

[color "interactive"]
	error = "bold #ae5158"
	header = "bold #573c72"
	help = "#514b44"
	plain = "#31312b"
	prompt = "bold #893517"

[color "push"]
	error = "bold #ae5158"

[color "remote"]
	error = "bold #ae5158"
	hint = "#185b5b"
	success = "#385a35"
	warning = "#926e25"

[color "status"]
	added = "#385a35"
	branch = "bold #893517"
	changed = "bold #926e25"
	header = "#514b44"
	localBranch = "#37526a"
	noBranch = "bold #ae5158"
	remoteBranch = "#185b5b"
	unmerged = "bold #ae5158"
	untracked = "#185b5b"
	updated = "#385a35"

[color "transport"]
	rejected = "bold #ae5158"
