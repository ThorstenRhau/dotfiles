# Generated from the token-flint light palette. Do not edit manually.

[color "advice"]
	hint = "#09567B"

[color "blame"]
	repeatedLines = "#444E59"

[color "branch"]
	current = "bold #902A03"
	local = "bold #035378"
	plain = "#283039"
	remote = "bold #09567B"
	upstream = "bold #09567B"
	worktree = "bold #852500"

[color "decorate"]
	HEAD = "bold #902A03"
	branch = "bold #3D5902"
	grafted = "#414C57"
	remoteBranch = "bold #09567B"
	stash = "#852500"
	tag = "bold #2F4500"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#035378"

[color "grep"]
	column = "#09567B"
	context = "#414C57"
	filename = "bold #035378"
	function = "#852500"
	lineNumber = "#996914"
	match = "bold #902A03"
	matchContext = "bold #902A03"
	matchSelected = "bold #902A03"
	selected = "#283039"
	separator = "#444E59"

[color "interactive"]
	error = "bold #BF3F50"
	header = "bold #852500"
	help = "#414C57"
	plain = "#283039"
	prompt = "bold #902A03"

[color "push"]
	error = "bold #BF3F50"

[color "remote"]
	error = "bold #BF3F50"
	hint = "#09567B"
	success = "#3D5902"
	warning = "#996914"

[color "status"]
	added = "#3D5902"
	branch = "bold #902A03"
	changed = "bold #996914"
	header = "#414C57"
	localBranch = "#035378"
	noBranch = "bold #BF3F50"
	remoteBranch = "#09567B"
	unmerged = "bold #BF3F50"
	untracked = "#09567B"
	updated = "#3D5902"

[color "transport"]
	rejected = "bold #BF3F50"
