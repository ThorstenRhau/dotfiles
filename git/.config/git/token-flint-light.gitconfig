# Generated from the token-flint light palette. Do not edit manually.

[color "advice"]
	hint = "#01575b"

[color "blame"]
	repeatedLines = "#636d79"

[color "branch"]
	current = "bold #902a03"
	local = "bold #035378"
	plain = "#283039"
	remote = "bold #01575b"
	upstream = "bold #01575b"
	worktree = "bold #852500"

[color "decorate"]
	HEAD = "bold #902a03"
	branch = "bold #3d5902"
	grafted = "#5a6571"
	remoteBranch = "bold #01575b"
	stash = "#852500"
	tag = "bold #6b4600"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#035378"

[color "grep"]
	column = "#01575b"
	context = "#5a6571"
	filename = "bold #035378"
	function = "#852500"
	lineNumber = "#916103"
	match = "bold #902a03"
	matchContext = "bold #902a03"
	matchSelected = "bold #902a03"
	selected = "#283039"
	separator = "#636d79"

[color "interactive"]
	error = "bold #bf3f50"
	header = "bold #852500"
	help = "#5a6571"
	plain = "#283039"
	prompt = "bold #902a03"

[color "push"]
	error = "bold #bf3f50"

[color "remote"]
	error = "bold #bf3f50"
	hint = "#01575b"
	success = "#3d5902"
	warning = "#916103"

[color "status"]
	added = "#3d5902"
	branch = "bold #902a03"
	changed = "bold #916103"
	header = "#5a6571"
	localBranch = "#035378"
	noBranch = "bold #bf3f50"
	remoteBranch = "#01575b"
	unmerged = "bold #bf3f50"
	untracked = "#01575b"
	updated = "#3d5902"

[color "transport"]
	rejected = "bold #bf3f50"
