# Generated from the token-flint light palette. Do not edit manually.

[color "advice"]
	hint = "#01575B"

[color "blame"]
	repeatedLines = "#636D79"

[color "branch"]
	current = "bold #902A03"
	local = "bold #035378"
	plain = "#283039"
	remote = "bold #01575B"
	upstream = "bold #01575B"
	worktree = "bold #852500"

[color "decorate"]
	HEAD = "bold #902A03"
	branch = "bold #3D5902"
	grafted = "#5A6571"
	remoteBranch = "bold #01575B"
	stash = "#852500"
	tag = "bold #6b4600"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#035378"

[color "grep"]
	column = "#01575B"
	context = "#5A6571"
	filename = "bold #035378"
	function = "#852500"
	lineNumber = "#916103"
	match = "bold #902A03"
	matchContext = "bold #902A03"
	matchSelected = "bold #902A03"
	selected = "#283039"
	separator = "#636D79"

[color "interactive"]
	error = "bold #BF3F50"
	header = "bold #852500"
	help = "#5A6571"
	plain = "#283039"
	prompt = "bold #902A03"

[color "push"]
	error = "bold #BF3F50"

[color "remote"]
	error = "bold #BF3F50"
	hint = "#01575B"
	success = "#3D5902"
	warning = "#916103"

[color "status"]
	added = "#3D5902"
	branch = "bold #902A03"
	changed = "bold #916103"
	header = "#5A6571"
	localBranch = "#035378"
	noBranch = "bold #BF3F50"
	remoteBranch = "#01575B"
	unmerged = "bold #BF3F50"
	untracked = "#01575B"
	updated = "#3D5902"

[color "transport"]
	rejected = "bold #BF3F50"
