# Generated from the token-temper light palette. Do not edit manually.

[color "advice"]
	hint = "#005B53"

[color "blame"]
	repeatedLines = "#444E59"

[color "branch"]
	current = "bold #005850"
	local = "bold #005850"
	plain = "#283039"
	remote = "bold #005B53"
	upstream = "bold #005B53"
	worktree = "bold #612C8D"

[color "decorate"]
	HEAD = "bold #005850"
	branch = "bold #005B53"
	grafted = "#414C57"
	remoteBranch = "bold #005B53"
	stash = "#612C8D"
	tag = "bold #004741"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#005850"

[color "grep"]
	column = "#005B53"
	context = "#414C57"
	filename = "bold #005850"
	function = "#612C8D"
	lineNumber = "#946B1E"
	match = "bold #005850"
	matchContext = "bold #005850"
	matchSelected = "bold #005850"
	selected = "#283039"
	separator = "#444E59"

[color "interactive"]
	error = "bold #BF3F50"
	header = "bold #612C8D"
	help = "#414C57"
	plain = "#283039"
	prompt = "bold #005850"

[color "push"]
	error = "bold #BF3F50"

[color "remote"]
	error = "bold #BF3F50"
	hint = "#005B53"
	success = "#005B53"
	warning = "#946B1E"

[color "status"]
	added = "#005B53"
	branch = "bold #005850"
	changed = "bold #946B1E"
	header = "#414C57"
	localBranch = "#005850"
	noBranch = "bold #BF3F50"
	remoteBranch = "#005B53"
	unmerged = "bold #BF3F50"
	untracked = "#005B53"
	updated = "#005B53"

[color "transport"]
	rejected = "bold #BF3F50"
