# Generated from the token-temper light palette. Do not edit manually.

[color "advice"]
	hint = "#005B53"

[color "blame"]
	repeatedLines = "#636D79"

[color "branch"]
	current = "bold #005850"
	local = "bold #055667"
	plain = "#283039"
	remote = "bold #005B53"
	upstream = "bold #005B53"
	worktree = "bold #612C8D"

[color "decorate"]
	HEAD = "bold #005850"
	branch = "bold #2B5A39"
	grafted = "#5A6571"
	remoteBranch = "bold #005B53"
	stash = "#612C8D"
	tag = "bold #683495"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#055667"

[color "grep"]
	column = "#005B53"
	context = "#5A6571"
	filename = "bold #055667"
	function = "#612C8D"
	lineNumber = "#8C6312"
	match = "bold #005850"
	matchContext = "bold #005850"
	matchSelected = "bold #005850"
	selected = "#283039"
	separator = "#636D79"

[color "interactive"]
	error = "bold #BF3F50"
	header = "bold #612C8D"
	help = "#5A6571"
	plain = "#283039"
	prompt = "bold #005850"

[color "push"]
	error = "bold #BF3F50"

[color "remote"]
	error = "bold #BF3F50"
	hint = "#005B53"
	success = "#2B5A39"
	warning = "#8C6312"

[color "status"]
	added = "#2B5A39"
	branch = "bold #005850"
	changed = "bold #8C6312"
	header = "#5A6571"
	localBranch = "#055667"
	noBranch = "bold #BF3F50"
	remoteBranch = "#005B53"
	unmerged = "bold #BF3F50"
	untracked = "#005B53"
	updated = "#2B5A39"

[color "transport"]
	rejected = "bold #BF3F50"
