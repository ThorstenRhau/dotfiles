# Generated from the token-temper light palette. Do not edit manually.

[color "advice"]
	hint = "#005b53"

[color "blame"]
	repeatedLines = "#636d79"

[color "branch"]
	current = "bold #005850"
	local = "bold #055667"
	plain = "#283039"
	remote = "bold #005b53"
	upstream = "bold #005b53"
	worktree = "bold #612c8d"

[color "decorate"]
	HEAD = "bold #005850"
	branch = "bold #2b5a39"
	grafted = "#5a6571"
	remoteBranch = "bold #005b53"
	stash = "#612c8d"
	tag = "bold #683495"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#055667"

[color "grep"]
	column = "#005b53"
	context = "#5a6571"
	filename = "bold #055667"
	function = "#612c8d"
	lineNumber = "#8c6312"
	match = "bold #005850"
	matchContext = "bold #005850"
	matchSelected = "bold #005850"
	selected = "#283039"
	separator = "#636d79"

[color "interactive"]
	error = "bold #bf3f50"
	header = "bold #612c8d"
	help = "#5a6571"
	plain = "#283039"
	prompt = "bold #005850"

[color "push"]
	error = "bold #bf3f50"

[color "remote"]
	error = "bold #bf3f50"
	hint = "#005b53"
	success = "#2b5a39"
	warning = "#8c6312"

[color "status"]
	added = "#2b5a39"
	branch = "bold #005850"
	changed = "bold #8c6312"
	header = "#5a6571"
	localBranch = "#055667"
	noBranch = "bold #bf3f50"
	remoteBranch = "#005b53"
	unmerged = "bold #bf3f50"
	untracked = "#005b53"
	updated = "#2b5a39"

[color "transport"]
	rejected = "bold #bf3f50"
