# Generated from the token-meridian dark palette. Do not edit manually.

[color "advice"]
	hint = "#cf9c70"

[color "blame"]
	repeatedLines = "#91887d"

[color "branch"]
	current = "bold #e89a49"
	local = "bold #7cc1dc"
	plain = "#c9c0b1"
	remote = "bold #cf9c70"
	upstream = "bold #cf9c70"
	worktree = "bold #c69de8"

[color "decorate"]
	HEAD = "bold #e89a49"
	branch = "bold #8cbb62"
	grafted = "#a69c91"
	remoteBranch = "bold #cf9c70"
	stash = "#c69de8"
	tag = "bold #f8c88f"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#7cc1dc"

[color "grep"]
	column = "#cf9c70"
	context = "#a69c91"
	filename = "bold #7cc1dc"
	function = "#c69de8"
	lineNumber = "#c2b040"
	match = "bold #e89a49"
	matchContext = "bold #e89a49"
	matchSelected = "bold #e89a49"
	selected = "#c9c0b1"
	separator = "#91887d"

[color "interactive"]
	error = "bold #dd8384"
	header = "bold #c69de8"
	help = "#a69c91"
	plain = "#c9c0b1"
	prompt = "bold #e89a49"

[color "push"]
	error = "bold #dd8384"

[color "remote"]
	error = "bold #dd8384"
	hint = "#cf9c70"
	success = "#8cbb62"
	warning = "#c2b040"

[color "status"]
	added = "#8cbb62"
	branch = "bold #e89a49"
	changed = "bold #c2b040"
	header = "#a69c91"
	localBranch = "#7cc1dc"
	noBranch = "bold #dd8384"
	remoteBranch = "#cf9c70"
	unmerged = "bold #dd8384"
	untracked = "#cf9c70"
	updated = "#8cbb62"

[color "transport"]
	rejected = "bold #dd8384"
