# Generated from the token-meridian dark palette. Do not edit manually.

[color "advice"]
	hint = "#d9a86e"

[color "blame"]
	repeatedLines = "#91887d"

[color "branch"]
	current = "bold #e89a49"
	local = "bold #66abc6"
	plain = "#c9c0b1"
	remote = "bold #d9a86e"
	upstream = "bold #d9a86e"
	worktree = "bold #b991db"

[color "decorate"]
	HEAD = "bold #e89a49"
	branch = "bold #8cbb62"
	grafted = "#a69c91"
	remoteBranch = "bold #d9a86e"
	stash = "#b991db"
	tag = "bold #de88a6"

[color "diff"]
	# Keep glg's commit colour, but let delta style diff bodies.
	commit = "#66abc6"

[color "grep"]
	column = "#d9a86e"
	context = "#a69c91"
	filename = "bold #66abc6"
	function = "#b991db"
	lineNumber = "#bf9c53"
	match = "bold #e89a49"
	matchContext = "bold #e89a49"
	matchSelected = "bold #e89a49"
	selected = "#c9c0b1"
	separator = "#91887d"

[color "interactive"]
	error = "bold #dd8384"
	header = "bold #b991db"
	help = "#a69c91"
	plain = "#c9c0b1"
	prompt = "bold #e89a49"

[color "push"]
	error = "bold #dd8384"

[color "remote"]
	error = "bold #dd8384"
	hint = "#d9a86e"
	success = "#8cbb62"
	warning = "#bf9c53"

[color "status"]
	added = "#8cbb62"
	branch = "bold #e89a49"
	changed = "bold #bf9c53"
	header = "#a69c91"
	localBranch = "#66abc6"
	noBranch = "bold #dd8384"
	remoteBranch = "#d9a86e"
	unmerged = "bold #dd8384"
	untracked = "#d9a86e"
	updated = "#8cbb62"

[color "transport"]
	rejected = "bold #dd8384"
