# Global Git ignore: operating system and editor junk plus local secrets.
# Language and build patterns belong in each project's own .gitignore.

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Editor backup and swap files
*~
*.sw?

# Local environment files that hold secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Assorted dot files that are not to be handled in this repo
**/.claude/settings.local.json
