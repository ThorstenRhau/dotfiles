# Rate-limited macOS appearance check (every 3rd prompt).
# Registered via: add-zsh-hook precmd _check_appearance

[[ "$_OS_TYPE" != "Darwin" ]] && return

((_appearance_prompt_count++))
((_appearance_prompt_count < 3)) && return
_appearance_prompt_count=0

local val new_appearance new_token_appearance
val=$(defaults read -g AppleInterfaceStyle 2>/dev/null)
new_token_appearance="$(_token_appearance)"

if [[ "$val" == "Dark" ]]; then
  new_appearance=dark
else
  new_appearance=light
fi

if [[ "$new_appearance" != "$SYSTEM_APPEARANCE" ||
  "$new_token_appearance" != "$TOKEN_APPEARANCE" ]]; then
  local appearance_changed=false
  [[ "$new_appearance" != "$SYSTEM_APPEARANCE" ]] && appearance_changed=true
  export SYSTEM_APPEARANCE="$new_appearance"
  _apply_appearance
  if [[ "$appearance_changed" == true ]]; then
    print -- "Ghostty appearance changed. Reload with Cmd+Shift+, (or open a new surface)."
  fi
fi
