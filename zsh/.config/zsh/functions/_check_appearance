# Rate-limited appearance check (every 3rd prompt).
# Registered via: add-zsh-hook precmd _check_appearance
# Only macOS re-reads the system mode here; WSL2 reads Windows' mode once at
# startup because each reg.exe call crosses the Windows interop boundary.

((_appearance_prompt_count++))
((_appearance_prompt_count < 3)) && return
_appearance_prompt_count=0

local new_appearance="$SYSTEM_APPEARANCE" new_token_appearance
[[ "$_OS_TYPE" == "Darwin" ]] && new_appearance="$(_system_appearance)"
new_token_appearance="$(_token_appearance)"

if [[ "$new_appearance" != "$SYSTEM_APPEARANCE" ||
  "$new_token_appearance" != "$TOKEN_APPEARANCE" ]]; then
  export SYSTEM_APPEARANCE="$new_appearance"
  _apply_appearance
fi
