# Persist and apply a Token appearance family.

local usage="Usage: token-theme [${(j:|:)_token_appearances}|next|--help]"
local requested current state_dir state_file stored
current="$(_token_appearance)"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/token"
state_file="$state_dir/appearance"
[[ -r "$state_file" ]] && stored="$(<"$state_file")"

case "$#:$1" in
  0:) print -r -- "$current"; return 0 ;;
  1:--help | 1:-h)
    print -r -- "$usage"
    return 0
    ;;
  1:next)
    local -i index=${_token_appearances[(Ie)$current]}
    requested="${_token_appearances[index % $#_token_appearances + 1]}"
    ;;
  1:*) ((${_token_appearances[(Ie)$1]})) && requested="$1" ;;
esac
if [[ -z "$requested" ]]; then
  print -u2 -r -- "$usage"
  return 2
fi

if [[ "$requested" == "$current" ]]; then
  if [[ ! -e "$state_file" || "$stored" == "$requested" ]]; then
    print -r -- "$current"
    return 0
  fi
fi

mkdir -m 700 -p "$state_dir" || return 1
chmod 700 "$state_dir" || return 1
_write_token_adapter "$state_file" "$requested" || return 1

_apply_appearance
print -r -- "$requested"
