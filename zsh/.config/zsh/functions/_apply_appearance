# Apply the selected Token appearance to all tools for $SYSTEM_APPEARANCE.

local appearance="$(_token_appearance)"
local previous_appearance="${TOKEN_APPEARANCE:-}"
export TOKEN_APPEARANCE="$appearance"

if [[ "$_OS_TYPE" != "Darwin" ]]; then
  export STARSHIP_CONFIG="$HOME/.config/starship.toml"
  export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"
  export FZF_DEFAULT_OPTS="$_FZF_BASE_OPTS"
  unset BAT_THEME DELTA_FEATURES
  return
fi

local mode=light
[[ "$SYSTEM_APPEARANCE" == "dark" ]] && mode=dark
local theme="$appearance-$mode"

export BAT_THEME="$theme"
export DELTA_FEATURES="$theme"
# Reuse our include across prompts and nested shells without replacing callers'
# Git configuration entries.
local git_count="${GIT_CONFIG_COUNT:-0}" git_index git_key git_value
if [[ "$git_count" == <-> ]]; then
  for ((git_index = 0; git_index < git_count; git_index++)); do
    git_key="GIT_CONFIG_KEY_$git_index"
    git_value="GIT_CONFIG_VALUE_$git_index"
    if [[ "${(P)git_key}" == include.path &&
      "${(P)git_value}" == "$HOME/.config/git/"(token|token-flint|token-temper|token-ultra|token-meridian)-(dark|light).gitconfig ]]; then
      break
    fi
  done
  export "GIT_CONFIG_KEY_$git_index=include.path"
  export "GIT_CONFIG_VALUE_$git_index=$HOME/.config/git/$theme.gitconfig"
  export GIT_CONFIG_COUNT=$((git_index == git_count ? git_count + 1 : git_count))
fi
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/$theme.yml"
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/themes/$theme"
export STARSHIP_CONFIG="$HOME/.config/starship-$theme.toml"

# Zsh syntax highlighting and completion colors
local zsh_theme="$ZDOTDIR/themes/$theme.zsh"
[[ -r "$zsh_theme" ]] && source "$zsh_theme"

# Carapace completion colors
local carapace_theme="$ZDOTDIR/themes/carapace-$theme.json"
local carapace_dir="${XDG_CONFIG_HOME:-$HOME/.config}/carapace"
[[ -r "$carapace_theme" ]] && mkdir -p "$carapace_dir" \
    && ! cmp -s "$carapace_theme" "$carapace_dir/styles.json" \
    && cp "$carapace_theme" "$carapace_dir/styles.json"

# FZF theme colors
local fzf_theme="$HOME/.config/fzf/themes/$theme.zsh"
[[ -r "$fzf_theme" ]] && source "$fzf_theme"

# Reconstruct FZF_DEFAULT_OPTS from base + theme
export FZF_DEFAULT_OPTS="$_FZF_BASE_OPTS $_FZF_THEME_OPTS"

# Long-running applications read small generated adapters on reload.
local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
local ghostty_adapter="$config_home/ghostty/token-active.ghostty"
local herdr_dir="$config_home/herdr"
local herdr_base="$herdr_dir/config.base.toml"
local herdr_theme="$herdr_dir/themes/$appearance.toml"
local herdr_config="$herdr_dir/config.toml"
local herdr_header="# Generated by _apply_appearance. Do not edit."
local tmux_adapter="$config_home/tmux/token-active.conf"
local ghostty_grade=15
[[ "$mode" == "dark" ]] && ghostty_grade=-15

local ghostty_content="theme = dark:$appearance-dark,light:$appearance-light
font-variation = GRAD = $ghostty_grade
font-variation-bold = GRAD = $ghostty_grade
font-variation-italic = GRAD = $ghostty_grade
font-variation-bold-italic = GRAD = $ghostty_grade"
if [[ ! -r "$ghostty_adapter" || "$(<"$ghostty_adapter")" != "$ghostty_content" ]]; then
  if _write_token_adapter "$ghostty_adapter" "$ghostty_content"; then
    # Include ancestor processes so the Ghostty hosting this shell reloads too.
    pkill -USR2 -a -x -u "$EUID" ghostty || {
      local reload_status=$?
      # No matching process is normal; retain pkill diagnostics for other errors.
      ((reload_status == 1)) || print -u2 -- "Unable to reload Ghostty (pkill status $reload_status)"
    }
  else
    print -u2 -- "Unable to update $ghostty_adapter"
  fi
fi

# Herdr has one config file, so combine its tracked preferences and selected
# Token family into a protected local runtime file.
if [[ -r "$herdr_base" ]]; then
  if [[ ! -r "$herdr_theme" ]]; then
    print -u2 -- "Unable to update Herdr: missing $herdr_theme"
  else
    local herdr_managed=true herdr_first_line herdr_content
    if [[ -e "$herdr_config" || -L "$herdr_config" ]]; then
      IFS= read -r herdr_first_line <"$herdr_config" 2>/dev/null || herdr_first_line=
      if [[ "$herdr_first_line" != "$herdr_header" ]]; then
        herdr_managed=false
        print -u2 -- "Refusing to overwrite unmanaged $herdr_config"
      fi
    fi

    if [[ "$herdr_managed" == true ]]; then
      herdr_content="$herdr_header
$(<"$herdr_base")

$(<"$herdr_theme")"
      if [[ ! -r "$herdr_config" || "$(<"$herdr_config")" != "$herdr_content" ]]; then
        if mkdir -m 700 -p "$herdr_dir" && chmod 700 "$herdr_dir" &&
          _write_token_adapter "$herdr_config" "$herdr_content" &&
          chmod 600 "$herdr_config"; then
          if (($+commands[herdr] || $+functions[herdr])); then
            local herdr_status
            herdr_status="$(herdr status server 2>/dev/null)"
            if [[ "$herdr_status" == "status: running"* ]]; then
              herdr server reload-config 2>/dev/null ||
                print -u2 -- "Unable to reload Herdr configuration"
            fi
          fi
        else
          print -u2 -- "Unable to update $herdr_config"
        fi
      fi
    fi
  fi
fi

_write_token_adapter "$tmux_adapter" \
  "set -g @token_appearance \"$appearance\"" ||
  print -u2 -- "Unable to update $tmux_adapter"

if [[ "$previous_appearance" != "$appearance" ]] && (($+commands[tmux])) &&
  tmux has-session 2>/dev/null; then
  local tmux_appearance
  tmux_appearance="$(tmux show-options -gqv @token_appearance 2>/dev/null)"
  if [[ "$tmux_appearance" != "$appearance" ]]; then
    tmux source-file "$config_home/tmux/tmux.conf" 2>/dev/null ||
      print -u2 -- "Unable to reload tmux theme"
  fi
fi
