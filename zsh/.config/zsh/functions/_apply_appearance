# Apply the selected Token appearance to all tools for $SYSTEM_APPEARANCE.

local appearance="$(_token_appearance)"
local previous_appearance="${TOKEN_APPEARANCE:-}"
export TOKEN_APPEARANCE="$appearance"

if [[ "$_OS_TYPE" != "Darwin" ]]; then
  export STARSHIP_CONFIG="$HOME/.config/starship.toml"
  export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"
  export FZF_DEFAULT_OPTS="$_FZF_BASE_OPTS"
  unset BAT_THEME DELTA_FEATURES GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
  return
fi

local mode=light
[[ "$SYSTEM_APPEARANCE" == "dark" ]] && mode=dark
local theme="$appearance-$mode"

export BAT_THEME="$theme"
export DELTA_FEATURES="$theme"
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=include.path
export GIT_CONFIG_VALUE_0="$HOME/.config/git/$theme.gitconfig"
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/$theme.yml"
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/themes/$theme"
export STARSHIP_CONFIG="$HOME/.config/starship-$theme.toml"

# Zsh syntax highlighting and completion colors
local zsh_theme="$ZDOTDIR/themes/$theme.zsh"
[[ -r "$zsh_theme" ]] && source "$zsh_theme"

# Carapace completion colors
local carapace_theme="$ZDOTDIR/themes/carapace-$theme.json"
local carapace_dir="${XDG_CONFIG_HOME:-$HOME/.config}/carapace"
[[ -r "$carapace_theme" ]] && mkdir -p "$carapace_dir" \
    && ! cmp -s "$carapace_theme" "$carapace_dir/styles.json" \
    && cp "$carapace_theme" "$carapace_dir/styles.json"

# FZF theme colors
local fzf_theme="$HOME/.config/fzf/themes/$theme.zsh"
[[ -r "$fzf_theme" ]] && source "$fzf_theme"

# Reconstruct FZF_DEFAULT_OPTS from base + theme
export FZF_DEFAULT_OPTS="$_FZF_BASE_OPTS $_FZF_THEME_OPTS"

# Long-running applications read small generated adapters on reload.
local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
local ghostty_adapter="$config_home/ghostty/token-active.ghostty"
local tmux_adapter="$config_home/tmux/token-active.conf"

_write_token_adapter "$ghostty_adapter" \
  "theme = dark:$appearance-dark,light:$appearance-light" ||
  print -u2 -- "Unable to update $ghostty_adapter"
_write_token_adapter "$tmux_adapter" \
  "set -g @token_appearance \"$appearance\"" ||
  print -u2 -- "Unable to update $tmux_adapter"

if [[ "$previous_appearance" != "$appearance" ]] && (($+commands[tmux])) &&
  tmux has-session 2>/dev/null; then
  local tmux_appearance
  tmux_appearance="$(tmux show-options -gqv @token_appearance 2>/dev/null)"
  if [[ "$tmux_appearance" != "$appearance" ]]; then
    tmux source-file "$config_home/tmux/tmux.conf" 2>/dev/null ||
      print -u2 -- "Unable to reload tmux theme"
  fi
fi
