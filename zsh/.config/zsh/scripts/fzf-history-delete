#!/usr/bin/env zsh
# Sourced by .zshrc: deletion must update the parent shell's history and widget.

_delete_history_entry() {
  # Use Zsh's parser and writer for complete events, encoding, and file locking.
  setopt localoptions no_aliases
  unsetopt share_history append_history inc_append_history inc_append_history_time

  [[ $# == 1 && -n "$1" && -n "$HISTFILE" ]] || return 1
  local history_file="$HISTFILE" history_size=$HISTSIZE save_size=$SAVEHIST
  local requested="${(b)1}"
  [[ -n "$HISTORY_IGNORE" ]] && requested="($HISTORY_IGNORE|$requested)"
  local HISTORY_IGNORE="$requested"

  fc -RI "$history_file" || return 1
  fc -W "$history_file" || return 1

  # Reuse one replacement context. HISTSIZE=0 retains recent events and cannot
  # reliably remove an entry from the current history list.
  if [[ "${_fzf_history_context:-0}" == 1 ]]; then
    fc -P || return 1
  fi
  fc -p "$history_file" "$history_size" "$save_size" || return 1
  typeset -g _fzf_history_context=1
}

_fzf-history-widget() {
  # Let fzf select an event, delete it in the parent shell, and reopen search.
  setopt localoptions no_aliases extendedglob
  zmodload zsh/parameter || return 1

  local saved_buffer saved_cursor selection event requested result
  while true; do
    saved_buffer="$BUFFER"
    saved_cursor=$CURSOR
    result=0
    fzf-history-widget || result=$?
    if [[ "$LBUFFER" != dotfiles-delete-history &&
      "$LBUFFER" != $'dotfiles-delete-history\n'* ]]; then
      return $result
    fi

    selection="${LBUFFER#*$'\n'}"
    # The native Zsh widget prefixes commands with their history event numbers.
    event="${${selection##[[:blank:]]#}%%[[:blank:]]*}"
    event="${event%\*}"
    BUFFER="$saved_buffer"
    CURSOR=$saved_cursor
    ((result == 0)) || return $result
    if [[ "$event" != <-> || ! -v "history[$event]" ]]; then
      zle -M 'Unable to identify the selected history entry.'
      return 1
    fi
    requested="${history[$event]}"
    if ! _delete_history_entry "$requested"; then
      zle -M 'Unable to delete the selected history entry.'
      return 1
    fi
  done
}
